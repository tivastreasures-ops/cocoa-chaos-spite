# Template only. Choose these values in the host's private environment settings.
# Never upload a completed .env or the desktop .private folder in the source ZIP.
CC_HOSTED=1
# Start with isolated previews. No Twitch initialization or paid ElevenLabs calls.
CC_PREVIEW_ONLY=1
PUBLIC_ORIGIN=https://chaos.toomanytabsopen.net
PORT=3000
# Separate persistent directory, outside application root and public_html.
CC_DATA_DIR=/home/ACCOUNT/cocoa-chaos-data
# Director chooses a unique passphrase of 20–300 characters.
CC_DIRECTOR_PASSWORD=
# Separate random read-only overlay credential of 32–256 characters.
CC_OVERLAY_TOKEN=
# Leave disabled until the approved one-owner Twitch cutover.
CC_TWITCH_INGEST=0
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=https://chaos.toomanytabsopen.net/auth/twitch/callback
ELEVENLABS_API_KEY=
