# Use the EXISTING Cocoa&Chaos Twitch application. Never paste secrets into chat.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Must match the registered application exactly.
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback
CANVAS_WIDTH=1920
CANVAS_HEIGHT=1080
# Optional future authenticated bridge; generate a random 32+ character value.
VOICE_BRIDGE_TOKEN=
